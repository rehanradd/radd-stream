<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access (required for all API calls) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background playback (MediaSessionService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Download progress notification + data-sync foreground service (Android 14+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Picture-in-Picture is entered through the Activity's supportsPictureInPicture flag and
         needs no permission; SYSTEM_ALERT_WINDOW was declared for an overlay player that does not
         exist, and asking for it sends users to a special-access page they can never satisfy. -->

    <!-- Keep screen on during playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Public video downloads on API 28 and older; API 29+ writes through DownloadManager. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Brand: android:label and the deep-link scheme below are generated from
      /brand.properties (resValue "brand_app_name" + manifestPlaceholder
      "brandScheme"). Registered components themselves must stay literal here —
      AGP requires that — but their name shown to users comes from the brand file.
    -->
    <application
        android:name=".RaddStreamApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/brand_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RaddStream"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: <brand.deeplink.scheme>://stream/12345 (brand.properties) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${brandScheme}" />
            </intent-filter>

            <!-- Local video files: a file manager, a browser's download row or a mail
                 attachment hands us an address for a file on THIS device and asks that it
                 be played. What arrives becomes the app's own player_local route, and
                 LocalVideoOpen is the single rule that decides whether an intent does —
                 the filter and the code are checked against each other by
                 LocalVideoIntentCensusTest.

                 Exactly the two schemes a local file can have, and nothing else: naming
                 http/https here would let any app push an address straight into the player,
                 past the server's stream handle, its adult redaction and its provenance.
                 No BROWSABLE either, so a browser link cannot land here.

                 The MIME wildcard is one entry, not a list: video/star matches mp4, mkv,
                 webm, x-matroska and every other video type the sender or the media
                 provider declares, which is the honest shape of the claim — the type comes
                 from whoever sent the intent, and no path pattern is promised here that
                 nothing can verify. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="video/*" />
                <data
                    android:scheme="file"
                    android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Background playback service.

             A MediaSessionService is reached by media controllers (the notification shade,
             lock-screen controls, Assistant, Android Auto), which do NOT hold
             BIND_MEDIA_BROWSER_SERVICE — that permission guards a MediaBrowserService, which this
             app does not have. Gating this service with it left every controller unable to bind,
             so the transport controls this screen promises were unreachable from outside the app.
             exported stays true because the controllers are external processes. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Public video downloads (pause/resume/progress notification) -->
        <service
            android:name=".data.downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
