<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      No `usesCleartextTraffic` here, and that is not an oversight: once the
      application declares a `networkSecurityConfig`, the platform ignores
      `usesCleartextTraffic` entirely. Debug gets its cleartext from this source
      set's own override of res/xml/network_security_config.xml, which permits any
      origin so a developer can aim the app at whatever machine they are testing.
      Release uses the generated policy — one host, from /brand.properties.
    -->
    <application />
</manifest>
