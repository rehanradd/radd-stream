# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
env/
venv/
.env
*.egg-info/
dist/
build/

# Database — too large and constantly changing, don't commit
Fast_Fetch/fast_fetch.db
Fast_Fetch/fast_fetch.db-shm
Fast_Fetch/fast_fetch.db-wal
*.db
*.db-shm
*.db-wal

# Generated catalog dumps. `fast_fetch.py export` and `export-html` write full
# ledger rows — site names, hoster names, resource ids, final URLs — which is our
# whole healing index. They belong on the operator's disk, not a public repo.
Fast_Fetch/fast_fetch_export.*
Fast_Fetch/database_view.html

# Scratch/temp files
Fast_Fetch/_fix_regex.py
Fast_Fetch/_*.py

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Android / Gradle
App/.gradle/
App/local.properties
*.jks

# Logs
*.log

# Local Replit configuration; may contain sensitive values
.replit

# Agent CLI session state (scheduling, scratch); never a product artifact
.qoder/
.qoder_account2/
.qoder_account3/
Fast_Fetch/auto_crawl_cron.sh

# Local live database storage directory
radd-stream-data/

# Runtime crawler tallies and the agent chat archive: regenerated every minute by
# the scrapers and auto_chat_sync.py, so they are working state, not product.
Fast_Fetch/*_status.json
Fast_Fetch/CHAT_HISTORY.md

# Credential / secret files — never track these
git-askpass.sh
.git-credentials
.netrc
*.pem
*.key

# Admin panel v2 — live data/secrets must never reach git.
# The live panel DB (sessions, TOTP secrets, tuning) lives in
# AdminV2/data-live/ on the VM; backups/ holds live DB copies.
# *.db / __pycache__ are already ignored above; these close the rest.
AdminV2/data-live/
AdminV2/backups/
AdminV2/*.log
